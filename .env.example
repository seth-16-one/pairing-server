PORT=3000
NODE_ENV=production

# Name shown in the WhatsApp message that carries the SESSION_ID
BOT_NAME=Telmas

# Behind one proxy (Render, a panel host, Cloudflare Tunnel) leave this at 1. Use 0 if exposed directly.
TRUST_PROXY=1

# Optional: restrict browser/app access, e.g. https://my-site.com,https://app.example.com (open when empty)
# CORS_ORIGINS=

# Abuse limits (defaults shown)
# MAX_PAIRINGS=5
# PAIRING_MAX_PER_IP_HOUR=10
# PAIRING_COOLDOWN_MS=5000
# PAIRING_REPLACE_AFTER_MS=60000

# Expiry
# PAIRING_SESSION_TIMEOUT_MS=600000
# QR_SESSION_TIMEOUT_MS=180000
# SESSION_HISTORY_TTL_MS=900000

# WhatsApp socket tuning
# WA_CONNECT_TIMEOUT_MS=30000
# WA_QUERY_TIMEOUT_MS=60000
# WA_QR_TIMEOUT_MS=60000

# Development only
BAILEYS_LOG_LEVEL=debug
